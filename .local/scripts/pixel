#!/usr/bin/env bash
# Launch scrcpy to the Pixel 7 over Tailscale ADB.
#
# Usage:
#   pixel              mirror the phone (tuned for remote Tailscale: 2M, 800px, 7fps, no audio)
#   pixel --max-fps=30 pass any scrcpy flags through to override defaults
#
# Override target:
#   PIXEL_HOST=pixel-7 PIXEL_ADB_PORT=5555 pixel
#   PIXEL_IP=100.85.191.25 pixel

set -euo pipefail

PHONE_HOST="${PIXEL_HOST:-pixel-7}"
ADB_PORT="${PIXEL_ADB_PORT:-5555}"
ADB_TIMEOUT="${PIXEL_ADB_TIMEOUT:-5}"
PING_TIMEOUT="${PIXEL_PING_TIMEOUT:-3}"

fail() {
  echo "pixel: $*" >&2
  exit 1
}

note() {
  echo "pixel: $*" >&2
}

if ! command -v tailscale >/dev/null 2>&1; then
  fail "tailscale is not installed or not on PATH"
fi

if ! command -v adb >/dev/null 2>&1; then
  fail "adb is not installed or not on PATH"
fi

if ! command -v scrcpy >/dev/null 2>&1; then
  fail "scrcpy is not installed or not on PATH"
fi

if [[ -n "${PIXEL_IP:-}" ]]; then
  ip="$PIXEL_IP"
  peer_line=""
  target="${ip}:${ADB_PORT}"
  ping_host="$ip"
else
  peer_line="$(tailscale status 2>/dev/null | awk -v host="$PHONE_HOST" '$2 == host { print; exit }' || true)"
  if [[ -z "$peer_line" ]]; then
    fail "could not find Tailscale peer '$PHONE_HOST' on your tailnet (is tailscale running?)"
  fi

  ip="${peer_line%% *}"
  target="${PHONE_HOST}:${ADB_PORT}"
  ping_host="$PHONE_HOST"

  # Tailscale status can show "active; direct ...; offline, last seen ..." on one
  # line. Only treat the peer as offline when it is not active.
  if [[ "$peer_line" != *"active"* && "$peer_line" == *"offline"* ]]; then
    last_seen="$(sed -n 's/.*last seen \([^,]*\).*/\1/p' <<<"$peer_line")"
    if [[ -n "$last_seen" ]]; then
      fail "$PHONE_HOST ($ip) is offline on Tailscale (last seen $last_seen). Wake the phone and make sure the Tailscale app is running."
    fi
    fail "$PHONE_HOST ($ip) is offline on Tailscale. Wake the phone and make sure the Tailscale app is running."
  fi
fi

# Drop stale IP-based duplicates before connect so adb/scrcpy never see two devices.
ip_target="${ip}:${ADB_PORT}"
if [[ "$target" != "$ip_target" ]]; then
  adb disconnect "$ip_target" >/dev/null 2>&1 || true
fi

ping_out="$(tailscale ping --until-direct=false -c 1 -timeout "${PING_TIMEOUT}s" "$ping_host" 2>&1)" || true
if [[ "$ping_out" != *"pong from"* ]]; then
  fail "cannot reach $PHONE_HOST at $ip over Tailscale (ping timed out after ${PING_TIMEOUT}s). The phone may be asleep or off-network."
fi

note "connecting to $PHONE_HOST at $target ..."

adb_out=""
if ! adb_out="$(timeout "$ADB_TIMEOUT" adb connect "$target" 2>&1)"; then
  rc=$?
  if [[ "$rc" -eq 124 ]]; then
    fail "ADB on $target did not answer within ${ADB_TIMEOUT}s. The phone is reachable on Tailscale, but wireless ADB is not up (unlock the phone, or replug USB once and run: adb tcpip $ADB_PORT)."
  fi
  if [[ -n "$adb_out" ]]; then
    fail "adb connect $target failed: $adb_out"
  fi
  fail "adb connect $target failed (exit $rc)"
fi

if [[ "$adb_out" == *"failed"* ]] || [[ "$adb_out" == *"refused"* ]]; then
  fail "adb connect $target failed: $adb_out"
fi

if ! timeout "$ADB_TIMEOUT" adb -s "$target" shell true >/dev/null 2>&1; then
  fail "connected to $target, but ADB is not responding. Unlock the phone and try again."
fi

note "launching scrcpy ..."
# Always mirror the physical screen — stale scrcpy virtual displays can cause a blank window.
exec scrcpy -s "$target" --display-id=0 -b2M -m800 --max-fps=7 --no-audio "$@"
